// Cloudflare Workers: the Worker runs the engine and prompts (server/), and serves
// the built app in dist/ as static files.
{
  // Beta: its own Worker, so it never touches the main site (app.kahyo.workers.dev).
  "name": "beta",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  // Branch builds run `wrangler preview`, which needs this block (it can stay empty).
  "previews": {},
  // Accounts (Supabase). Both are public values: the anon key only works through
  // row level security (supabase/schema.sql). Never put the service_role key here.
  "vars": {
    "SUPABASE_URL": "https://rsenwtbkvtjmfkfkzlbj.supabase.co",
    "SUPABASE_ANON_KEY": ""
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
