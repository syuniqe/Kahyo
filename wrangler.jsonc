// Cloudflare Workers: the Worker runs the engine and prompts (server/), and serves
// the built app in dist/ as static files.
{
  "name": "app",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  // Branch builds run `wrangler preview`, which needs this block (it can stay empty).
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
